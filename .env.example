# ==============================================================================
# PayLink — Multi-Gateway Payment Link Management Platform Environment Config
# ==============================================================================
# NOTE: Copy this file to .env and configure your values.
# NEVER commit real API keys, secrets, or credentials into version control!
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Base URLs
# - PUBLIC_BASE_URL: Publicly reachable address of the backend Express server
# - CLIENT_URL: Address of the frontend React application
# For phone / LAN Wi-Fi testing, set to host machine's IP (e.g. http://192.168.1.50:5000)
PUBLIC_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# CORS Allowed Origins (Comma-separated for multiple origins / LAN testing)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/paylink_db

# Security & Authentication (JWT)
# CRITICAL: In production, generate a cryptographically strong 64-byte random string (minimum 32 chars)
JWT_SECRET=replace_with_a_secure_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=24h

# Demo & Simulation Mode
# When 'true', generates instant simulated checkout URLs for testing when real credentials are absent
ENABLE_DEMO_MODE=true
DEMO_WEBHOOK_SECRET=demo_mode_secret_key_2026
DEMO_SIMULATED_LATENCY_MS=300

# Customer Callback Paths (relative to CLIENT_URL)
PAYMENT_SUCCESS_PATH=/payment-success
PAYMENT_CANCELLED_PATH=/payment-cancelled

# ==============================================================================
# 1. Stripe Configuration (Test/Live)
# Obtain from: https://dashboard.stripe.com/test/apikeys
# Webhook docs: https://stripe.com/docs/webhooks
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here

# ==============================================================================
# 2. Razorpay Configuration (Test/Live)
# Obtain from: https://dashboard.razorpay.com/app/keys
# Webhook docs: https://razorpay.com/docs/webhooks
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ==============================================================================
# 3. Cashfree Configuration (Sandbox/Production)
# Obtain from: https://merchant.cashfree.com/merchants/login
# Webhook docs: https://docs.cashfree.com/docs/webhooks
# Environment: TEST (Sandbox) or PROD (Production)
# ==============================================================================
CASHFREE_APP_ID=placeholder_cashfree_app_id
CASHFREE_SECRET_KEY=placeholder_cashfree_secret_key
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=TEST
CASHFREE_DEFAULT_CUSTOMER_PHONE=9999999999

# ==============================================================================
# 4. Frontend Public Variables (Vite client-side build only)
# Only variables prefixed with VITE_ are exposed to browser bundles.
# Never place gateway secret keys here!
# ==============================================================================
VITE_API_BASE_URL=/api
VITE_CLIENT_URL=http://localhost:5173
VITE_APP_TITLE=PayLink
