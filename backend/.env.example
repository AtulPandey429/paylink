# PayLink Backend Configuration Template
# Copy this file to backend/.env and configure your values.
# NEVER commit real credentials to version control!

NODE_ENV=development
PORT=5000

# Base URLs
PUBLIC_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# CORS Allowed Origins (Comma-separated for LAN/mobile testing)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/paylink_db

# Security & Authentication (JWT)
# Minimum 32 characters in production
JWT_SECRET=replace_with_a_secure_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=24h

# Demo & Simulation Mode
ENABLE_DEMO_MODE=true
DEMO_WEBHOOK_SECRET=demo_mode_secret_key_2026
DEMO_SIMULATED_LATENCY_MS=300

# Customer Callback Paths (relative to CLIENT_URL)
PAYMENT_SUCCESS_PATH=/payment-success
PAYMENT_CANCELLED_PATH=/payment-cancelled

# Gateway Credentials (Stripe)
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here

# Gateway Credentials (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Gateway Credentials (Cashfree)
CASHFREE_APP_ID=placeholder_cashfree_app_id
CASHFREE_SECRET_KEY=placeholder_cashfree_secret_key
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=TEST
CASHFREE_DEFAULT_CUSTOMER_PHONE=9999999999
